# Perception / Perceptron (Codex lane). Merge into root .env when Claude owns templates.

PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5
# PERCEPTRON_BASE_URL=

# Set to 1 only when intentionally running paid live tests
# CLIPCART_LIVE_PERCEPTRON=0
# CLIPCART_LIVE_IMAGE=/absolute/path/to/real.jpg

# Optional limit overrides (SRS §9 defaults apply when unset)
# CLIPCART_MAX_VIDEO_BYTES=
# CLIPCART_MAX_IMAGE_BYTES=
# CLIPCART_MAX_VIDEO_MS=
# CLIPCART_MAX_INITIAL_FRAMES=
# CLIPCART_FRAME_MAX_SIDE=
