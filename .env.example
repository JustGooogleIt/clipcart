# ClipCart runtime configuration. Copy to .env (gitignored) and fill what you have.
# Missing keys produce labeled reduced modes, never silent fakes.

# --- Persistence: MongoDB Atlas (required for the Atlas track) ---
# Without it the API uses an in-process store reported as "local_memory" (not Atlas).
MONGODB_URI=
MONGODB_DB=clipcart

# --- Perception: Perceptron (T02 adapter) ---
# Without a key, detection is "unavailable" and users draw a box (manual crop fallback).
# The app reports Perceptron "live" only after a real call succeeds.
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1
PERCEPTION_MAX_FRAMES=6               # paid detect calls per upload (one per sampled frame)
PERCEPTION_MAX_ATTRIBUTE_CALLS=3      # paid attribute calls per upload
PERCEPTRON_MAX_TOKENS=1200
# PERCEPTION_PROVIDER=perceptron|fixture|none   (fixture = labeled dev data for the synthetic test clip only)

# --- Agent runtime: xAI Grok ---
# Without a key, search workers run rule-based queries and are labeled "rule_based".
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# --- Agent shopping research jobs (provider-neutral; see docs/contracts/agent-research.md) ---
FEATURE_AGENT_RESEARCH=false
RESEARCH_PROVIDER=fixture            # only "fixture" exists; the Grok Bot bridge is not proven (docs/grok-bot-bridge.md)
RESEARCH_JOB_TTL_S=900
RESEARCH_RESOLVE_DNS=true            # reject product URLs whose host resolves to non-public addresses
# Bridge probe only (scripts/experiments/grokbot_bridge_probe.py); never committed:
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_KEY=
# PROBE_PUBLIC_BASE_URL=

# --- YouTube clip download (permitted IDs only; see docs/fit-checks.md) ---
# Off by default. When on, only listed video IDs may be analyzed via URL.
FEATURE_YOUTUBE_DOWNLOAD=false
# Fit-check Shorts truth set (comma-separated). Expand as you get written permission.
YOUTUBE_ALLOWED_VIDEO_IDS=zf6CmntK3BY,fGZB8iLJJ7E,g5mXVuj-eEI,GArRdb6qAZ8,BiF8fA2kMgE,yJ4vevoYXHU,7aSXFmRYGSk,dAKca9yKo_U,k12-rM2V_pE,KGEXdHOOfWU
# YOUTUBE_CACHE_MAX_DURATION_S=90
# YOUTUBE_CACHE_TTL_S=3600

# --- Style memory (docs/contracts/style-memory.md) ---
FEATURE_STYLE_MEMORY=false
STYLE_MODEL_PROVIDER=ollama          # ollama | openai_compatible (hosted) | none (rule-based parser only)
STYLE_MODEL=gemma4:e4b               # or gemma4:e2b if E4B is too slow
OLLAMA_BASE_URL=http://127.0.0.1:11434
STYLE_MODEL_TIMEOUT_S=8
STYLE_MODEL_EXPLANATIONS=false
# Hosted OpenAI-compatible style model (e.g. vLLM on a Lambda GPU). Not local: note text is sent there.
STYLE_REMOTE_BASE_URL=               # e.g. http://127.0.0.1:8002/v1 through an SSH tunnel
STYLE_REMOTE_API_KEY=                # secret; never commit
STYLE_REMOTE_MODEL=                  # e.g. gaunernst/gemma-3-12b-it-int4-awq
STYLE_REMOTE_LABEL=Gemma hosted on Lambda (not local)
STYLE_REMOTE_JSON_MODE=prompt        # prompt | schema
STYLE_REMOTE_MAX_TOKENS=300

# --- Catalog (teammate adapter, merged PR #1) ---
CATALOG_PROVIDER=solescout          # solescout | fixture | ebay
SOLESCOUT_BASE_URL=https://solescout.ai
SOLESCOUT_TIMEOUT_S=20
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# --- Search budgets (SRS section 10) ---
SEARCH_DEADLINE_S=60
SEARCH_MAX_TOOL_CALLS=12
SEARCH_MAX_DETAIL_CALLS=6

# --- Feature flags: off until P0 works ---
FEATURE_PHOTON=false
FEATURE_VOICE=false
FEATURE_SOLANA=false

# --- Local runtime ---
COOKIE_SECURE=false                 # true when served over HTTPS
# CLIPCART_MEDIA_ROOT=services/api/.data/media
