        "exifOrientation": {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        "orientedHeight": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "orientedWidth": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "outputHeight": {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        "outputWidth": {
          "exclusiveMinimum": 0,
